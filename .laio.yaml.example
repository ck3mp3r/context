---
name: context

path: .

pane_cmd_delay: 500

windows:
  - name: code
    flex_direction: row
    panes:
      - name: Editor
        flex: 2
        commands:
          - command: ^$env.EDITOR
      - name: Opencode
        flex: 1
        commands:
          - command: ^opencode
            args:
              - --port
  - name: misc
    flex_direction: row
    panes:
      - flex: 5
      - flex: 2
        flex_direction: column
        panes:
          - flex: 1
            commands:
              - command: trunk
                args:
                  - serve
          - flex: 1
            commands:
              - command: scripts/dev-service
          - flex: 1
            commands:
              - command: scripts/dev-app

